{"id": "pbg_vcell_fvsolver.composites.rd-decay-with-viz", "name": "rd-decay-with-viz", "description": "VCell FV reaction-diffusion decay demo with a wired Visualization Step. Each update produces a Plotly HTML figure of the per-species mean and total concentration trajectories, written to the 'viz_html' store.", "parameters": {"duration": {"type": "float", "default": 1.0, "description": "Total simulated time in seconds."}, "output_time_step": {"type": "float", "default": 0.25, "description": "Snapshot cadence written by the solver."}, "interval": {"type": "float", "default": 0.25, "description": "PBG update interval between snapshots."}, "viz_title": {"type": "string", "default": "VCell FV reaction-diffusion", "description": "Title displayed at the top of the Plotly figure."}}, "state": {"rd": {"_type": "process", "address": "local:VCellFVProcess", "config": {"antimony": "compartment ec;\ncompartment cell;\nspecies A in cell;\nspecies B in cell;\nA -> B; k*A\nk = 0.3\nA = 0\nB = 0\n", "compartment": "cell", "extent_x": 4.0, "extent_y": 4.0, "extent_z": 4.0, "mesh_x": 5, "mesh_y": 5, "mesh_z": 5, "duration": 1.0, "output_time_step": 0.25, "init_concs": {"A": "10.0", "B": "0.0"}, "diff_coefs": {"A": 0.0, "B": 0.0}, "track_species": ["A", "B"], "quiet": true}, "inputs": {}, "outputs": {"fields": ["stores", "fields"], "means": ["stores", "means"], "totals": ["stores", "totals"], "time": ["stores", "last_time"], "num_snapshots": ["stores", "num_snapshots"], "snapshot_index": ["stores", "snapshot_index"]}, "interval": 0.25, "interval_label": "0.25 s"}, "stores": {"fields": {}, "means": {}, "totals": {}, "last_time": 0.0, "num_snapshots": 0, "snapshot_index": 0, "viz_html": ""}, "viz": {"_type": "step", "address": "local:RDFieldPlots", "config": {"title": "VCell FV reaction-diffusion"}, "inputs": {"means": ["stores", "means"], "totals": ["stores", "totals"], "time": ["global_time"]}, "outputs": {"html": ["stores", "viz_html"]}}, "emitter": {"_type": "step", "address": "local:RAMEmitter", "config": {"emit": {"time": "float", "num_snapshots": "integer", "snapshot_index": "integer", "means": "map[float]", "totals": "map[float]"}}, "inputs": {"time": ["global_time"], "num_snapshots": ["stores", "num_snapshots"], "snapshot_index": ["stores", "snapshot_index"], "means": ["stores", "means"], "totals": ["stores", "totals"]}}, "_declared_emit_paths": ["global_time", "stores/num_snapshots", "stores/snapshot_index", "stores/means", "stores/totals"]}, "schema": {}, "overrides": {}, "requires": {"processes": ["VCellFVProcess", "RDFieldPlots", "RAMEmitter"]}, "tags": ["pde", "reaction-diffusion", "vcell", "demo", "visualization"], "visualizations": [], "analyses": [], "emitters": [], "kind": "spec", "module": "", "default_n_steps": null, "preferred_time": null, "svg": null, "wiring_status": "ready", "run_kind": "temporal", "notice": null}